PORT=5000
MONGO_URI=mongodb://localhost:27017/drs_quick_serve
JWT_SECRET=supersecretjwtkeydrsquickserve12345
CLIENT_URL=http://localhost:5173

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_SYSh7FU8tidKTo
# RAZORPAY_KEY_SECRET is required for production payments verification. Let's keep it blank or use placeholder.
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Authentication (Google Sign-In verification)
# Copy Project ID from Firebase Console -> Project Settings -> General
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: share Web App config safely if not placed in frontend/.env
# FIREBASE_API_KEY=your_firebase_web_api_key
# FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# FIREBASE_APP_ID=your_firebase_app_id

# Optional Direct Google OAuth / OpenID Connect (only needed if using non-Firebase Google OAuth)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
